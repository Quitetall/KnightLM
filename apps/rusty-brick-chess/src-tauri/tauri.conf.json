{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustyBrickChess",
  "version": "0.1.0",
  "identifier": "org.knightlm.rustybrickchess",
  "build": {
    "frontendDist": "../frontend/public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../frontend/public/": "frontend/",
      "bundled-engine/": "engine/",
      "../../../crates/contract/schemas/model_tools.json": "model-runtime/crates/contract/schemas/model_tools.json",
      "../../../model/configs/models/smolvlm-500m.json": "model-runtime/model/configs/models/smolvlm-500m.json",
      "../../../model/corpus/pipeline.py": "model-runtime/model/corpus/pipeline.py",
      "../../../model/corpus/reasoning.py": "model-runtime/model/corpus/reasoning.py",
      "../../../model/corpus/reasoning2.py": "model-runtime/model/corpus/reasoning2.py",
      "../../../model/corpus/render.py": "model-runtime/model/corpus/render.py",
      "../../../model/corpus/s0.py": "model-runtime/model/corpus/s0.py",
      "../../../model/encoder/__init__.py": "model-runtime/model/encoder/__init__.py",
      "../../../model/encoder/encoder.py": "model-runtime/model/encoder/encoder.py",
      "../../../model/encoder/inject.py": "model-runtime/model/encoder/inject.py",
      "../../../model/encoder/manifest.py": "model-runtime/model/encoder/manifest.py",
      "../../../model/encoder/planes.py": "model-runtime/model/encoder/planes.py",
      "../../../model/eval/__init__.py": "model-runtime/model/eval/__init__.py",
      "../../../model/eval/explain.py": "model-runtime/model/eval/explain.py",
      "../../../model/policy_head/__init__.py": "model-runtime/model/policy_head/__init__.py",
      "../../../model/policy_head/agree.py": "model-runtime/model/policy_head/agree.py",
      "../../../model/policy_head/head.py": "model-runtime/model/policy_head/head.py",
      "../../../model/policy_head/manifest.py": "model-runtime/model/policy_head/manifest.py",
      "../../../model/policy_head/space.py": "model-runtime/model/policy_head/space.py",
      "../../../model/prompt.py": "model-runtime/model/prompt.py",
      "../../../model/serve/coach.py": "model-runtime/model/serve/coach.py",
      "../../../model/serve/fake_server.py": "model-runtime/model/serve/fake_server.py",
      "../../../model/serve/head.py": "model-runtime/model/serve/head.py",
      "../../../model/serve/inference.py": "model-runtime/model/serve/inference.py",
      "../../../model/serve/play.py": "model-runtime/model/serve/play.py",
      "../../../model/serve/requirements.txt": "model-runtime/model/serve/requirements.txt",
      "../../../model/serve/server.py": "model-runtime/model/serve/server.py",
      "../../../model/tokenizer/arms.py": "model-runtime/model/tokenizer/arms.py",
      "../../../model/tokenizer/cgt.py": "model-runtime/model/tokenizer/cgt.py",
      "../../../model/tokenizer/errors.py": "model-runtime/model/tokenizer/errors.py",
      "../../../model/tokenizer/moves.py": "model-runtime/model/tokenizer/moves.py",
      "../../../model/tokenizer/position.py": "model-runtime/model/tokenizer/position.py",
      "../../../model/tokenizer/vocab.py": "model-runtime/model/tokenizer/vocab.py"
    },
    "shortDescription": "Chess database and analysis",
    "longDescription": "RustyBrickChess: local chess database, analysis board, openings, puzzles and repertoire training.",
    "category": "BoardGame",
    "publisher": "KnightLM",
    "copyright": "AGPL-3.0-only",
    "license": "AGPL-3.0-only",
    "fileAssociations": [
      {
        "ext": [
          "pgn"
        ],
        "name": "Portable Game Notation",
        "description": "Chess game file (PGN)",
        "mimeType": "application/vnd.chess-pgn",
        "role": "Editor"
      }
    ],
    "linux": {
      "deb": {
        "section": "games",
        "desktopTemplate": "packaging/rusty-brick-chess.desktop"
      },
      "rpm": {
        "desktopTemplate": "packaging/rusty-brick-chess.desktop"
      },
      "appimage": {}
    }
  }
}
