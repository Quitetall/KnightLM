{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustyBrickChess",
  "version": "0.1.0",
  "identifier": "org.knightlm.rustybrickchess",
  "build": {
    "frontendDist": "../frontend/public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../frontend/public/": "frontend/"
    },
    "shortDescription": "Chess database and analysis",
    "longDescription": "RustyBrickChess: local chess database, analysis board, openings, puzzles and repertoire training."
  }
}