{"actor_ref":"claude","class":"draft_history","document_uuid":"01a1a54a-3235-74c4-9518-5c7174543e28","id":"01a1a671-d9e1-75d2-907b-4f4e976a7c96","idempotency_key":"e8a507b03a4e50aedbf275fc0f7a6b9ca77e245df9e0941a09ca6f555ad522ff","occurred_at":"2026-11-04T12:04:01Z","payload":{"episode":0,"item":"i-909f","note":"DiffReport carries a reserved block (present, null) so R2 fills it without changing the shape; the progress overlay is already per user in every ChapterDiff.","on":"2026-11-04","target":"t-c76d/i-909f"},"type":"work.item_done","v":2}
